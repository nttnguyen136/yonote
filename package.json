{
  "name": "yonote",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "npm run copy:plantuml && vite",
    "build": "npm run copy:plantuml && tsc -b && vite build",
    "deploy": "npm run build && wrangler deploy --secrets-file .env.production",
    "typecheck": "tsc -b --pretty false",
    "cf-typegen": "wrangler types",
    "copy:plantuml": "node scripts/copy-plantuml-assets.mjs"
  },
  "dependencies": {
    "mermaid": "^11.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "@plantuml/core": "1.2026.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "wrangler": "^4.28.1"
  }
}
