{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yonote",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yonote-db",
      "database_id": "1bb166b9-9a00-4b22-b27a-b1fc118a7840"
    }
  ],
  "secrets": {
    "required": ["ACCESS_KEY", "TOKEN_SECRET"]
  },
  "observability": {
    "enabled": true
  }
}
